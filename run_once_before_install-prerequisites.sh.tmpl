{{- /* Runs only on the Fedora family (Fedora, RHEL, CentOS Stream, Rocky, Alma...). */ -}}
{{- /* On any other OS the template renders empty, and chezmoi skips empty scripts. */ -}}
{{- $fedoraFamily := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if eq .chezmoi.osRelease.id "fedora" -}}
{{-     $fedoraFamily = true -}}
{{-   else if hasKey .chezmoi.osRelease "idLike" -}}
{{-     if contains "fedora" .chezmoi.osRelease.idLike -}}
{{-       $fedoraFamily = true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- if $fedoraFamily -}}
#!/bin/bash
# Installs prerequisites on the Fedora family before chezmoi applies the dotfiles.
# Repos and packages come first, from run_onchange_before_00-install-packages
# (list in .chezmoidata/packages.yaml).
# Detected system: {{ .chezmoi.osRelease.id }} {{ .chezmoi.osRelease.versionID }}

set -euo pipefail

# --- Oh My Zsh -----------------------------------------------------------------
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    echo "🐚 Installing Oh My Zsh..."
    # RUNZSH=no    : don't start zsh at the end
    # CHSH=no      : we change the shell ourselves below
    # --keep-zshrc : leave the chezmoi-managed .zshrc alone
    RUNZSH=no CHSH=no sh -c \
        "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" \
        "" --unattended --keep-zshrc
else
    echo "🐚 Oh My Zsh already installed."
fi

# --- zsh as default shell ------------------------------------------------------
ZSH_PATH="$(command -v zsh)"
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$ZSH_PATH" ]; then
    echo "🔁 Setting zsh as default shell..."
    sudo usermod --shell "$ZSH_PATH" "$USER"
    echo "   (takes effect at next login)"
fi

# --- tmux config ---------------------------------------------------------------
mkdir -p ~/.tmux
git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm 2>/dev/null \
    || echo "tpm déjà présent, clone ignoré."

echo "Dans tmux : prefix + I pour installer les plugins."

echo "✅ Prerequisites installed."
{{ end -}}
