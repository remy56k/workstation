# Notifications dans le style de la barre : pastille sombre, coins arrondis, texte clair.

[global]
    width = (0, 380)
    height = (0, 200)
    origin = top-right
    offset = (12, 48)
    gap_size = 8

    font = CaskaydiaCove Nerd Font 13
    line_height = 3
    format = "<b>%s</b>\n%b"
    markup = full

    padding = 8
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 1
    frame_color = "#cdd6f414"
    separator_color = frame
    corner_radius = 7
    corners = all

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    progress_bar_corners = all

    icon_corner_radius = 7
    icon_corners = all
    min_icon_size = 16
    max_icon_size = 24

    transparency = 0
    highlight = "#89b4fa"

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#181825d1"
    foreground = "#a6adc8"
    frame_color = "#cdd6f414"
    timeout = 4

[urgency_normal]
    background = "#181825d1"
    foreground = "#cdd6f4"
    frame_color = "#cdd6f414"
    timeout = 6

[urgency_critical]
    background = "#181825ee"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
