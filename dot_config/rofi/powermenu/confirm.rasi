/*
 * Confirmation des actions qui quittent ou redémarrent la session.
 */

configuration {
    show-icons:      false;
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    bg:        #181825ee;
    bg-alt:    #31324499;
    fg:        #cdd6f4;
    muted:     #6c7086;
    accent:    #89b4fa;
    accent-fg: #1e1e2e;
    urgent:    #f38ba8;
    font:      "CaskaydiaCove Nerd Font 13";
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            320px;
    border:           1px;
    border-color:     #cdd6f422;
    border-radius:    16px;
    background-color: @bg;
    padding:          10px;
}

mainbox {
    spacing:          8px;
    background-color: transparent;
    children:         [ "message", "listview" ];
}

message {
    padding:          8px 12px;
    border-radius:    12px;
    background-color: @bg-alt;
    text-color:       @fg;
}

textbox {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
}

listview {
    lines:            1;
    columns:          2;
    spacing:          8px;
    cycle:            true;
    scrollbar:        false;
    background-color: transparent;
}

element {
    padding:          8px 12px;
    border-radius:    10px;
    background-color: @bg-alt;
    text-color:       @fg;
    cursor:           pointer;
}

element selected.normal {
    background-color: @accent;
    text-color:       @accent-fg;
}

element-text {
    background-color:  transparent;
    text-color:        inherit;
    horizontal-align:  0.5;
}
