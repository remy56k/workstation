/*
 * Confirmation des actions qui quittent ou redémarrent la session.
 */

configuration {
    show-icons:      false;
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@import "../themes/rounded-purple-glass.rasi"

window {
    location: center;
    anchor:   center;
    y-offset: 0;
    width:    320px;
}

mainbox {
    children: [ "message", "listview" ];
}

/* Le message passe en tête : pas de marge au-dessus. */
message {
    margin: 0;
}

textbox {
    horizontal-align: 0.5;
}

listview {
    lines:   1;
    columns: 2;
    spacing: 8px;
}

element {
    background-color: @bg2;
}

element-text {
    horizontal-align: 0.5;
}
