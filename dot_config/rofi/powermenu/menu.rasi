/*
 * Menu de session, même thème que le lanceur.
 */

configuration {
    show-icons:      false;
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@import "../themes/rounded-purple-glass.rasi"

window {
    location: center;
    anchor:   center;
    y-offset: 0;
    width:    320px;
}

inputbar {
    children: [ "prompt" ];
}

entry {
    enabled: false;
}

listview {
    lines: 5;
}
